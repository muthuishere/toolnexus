{
  "name": "a2e",
  "baseUrl": "https://api.a2e.ai/api",
  "headers": {
    "Authorization": "Bearer ${A2E_API_KEY}"
  },
  "verbs": {
    "image": {
      "mode": "async",
      "kind": "image",
      "start": {
        "method": "POST",
        "path": "/v1/userText2Image/start"
      },
      "defaults": {
        "name": "toolnexus",
        "model_type": "a2e"
      },
      "args": {
        "prompt": "prompt",
        "width": "width",
        "height": "height",
        "seed": "seed"
      },
      "idPath": "data.0._id",
      "poll": {
        "path": "/v1/userText2Image/{id}",
        "statusPath": "data.current_status",
        "done": [
          "completed"
        ],
        "failed": [
          "failed",
          "blocked",
          "canceled"
        ],
        "errorPath": "data.failed_message",
        "intervalMs": 3000,
        "timeoutMs": 300000
      },
      "resultPath": "data.image_urls"
    },
    "video": {
      "mode": "async",
      "kind": "video",
      "start": {
        "method": "POST",
        "path": "/v1/userImage2Video/start"
      },
      "defaults": {
        "name": "toolnexus",
        "generation_mode": "image-to-video",
        "negative_prompt": "blurry, distorted, low quality"
      },
      "args": {
        "image": "image_url",
        "prompt": "prompt",
        "seconds": "video_time"
      },
      "idPath": "data._id",
      "poll": {
        "path": "/v1/userImage2Video/{id}",
        "statusPath": "data.current_status",
        "done": [
          "completed"
        ],
        "failed": [
          "failed",
          "blocked",
          "canceled"
        ],
        "errorPath": "data.failed_message",
        "intervalMs": 5000,
        "timeoutMs": 900000
      },
      "resultPath": "data.result_url"
    },
    "speech": {
      "mode": "async",
      "kind": "audio",
      "start": {
        "method": "POST",
        "path": "/v1/seedAudio/start"
      },
      "args": {
        "text": "text_prompt",
        "voice": "references.0.speaker"
      },
      "idPath": "data._id",
      "poll": {
        "path": "/v1/seedAudio/{id}",
        "statusPath": "data.current_status",
        "done": [
          "completed"
        ],
        "failed": [
          "failed"
        ],
        "errorPath": "data.failed_message",
        "intervalMs": 3000,
        "timeoutMs": 300000
      },
      "resultPath": "data.result_url"
    },
    "talk": {
      "mode": "async",
      "kind": "video",
      "start": {
        "method": "POST",
        "path": "/v1/talkingPhoto/start"
      },
      "defaults": {
        "name": "toolnexus"
      },
      "args": {
        "image": "image_url",
        "audio": "audio_url"
      },
      "required": [
        "audio"
      ],
      "idPath": "data._id",
      "poll": {
        "path": "/v1/talkingPhoto/{id}",
        "statusPath": "data.current_status",
        "done": [
          "completed"
        ],
        "failed": [
          "failed",
          "blocked",
          "canceled"
        ],
        "errorPath": "data.failed_message",
        "intervalMs": 5000,
        "timeoutMs": 900000
      },
      "resultPath": "data.result_url"
    }
  },
  "errorEnvelope": {
    "codePath": "code",
    "okValues": [
      0
    ],
    "messagePath": "message"
  },
  "_doc": "a2e.ai preset (ADR 0036/0037). Embedded verbatim by every port as A2EMediaClient (SPEC §7G.9). Live-verified 2026-11-02: image, video, speech. talk is implemented per a2e's docs, UNVERIFIED. Set A2E_API_KEY. Result URLs expire (3-30 days); the built-in client downloads them by default."
}
