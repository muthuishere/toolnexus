{
 "defaultBands": {
  "low": 0.3,
  "high": 0.7
 },
 "questions": {
  "fixable": {
   "type": "noul",
   "instructions": "An autonomous agent can fix this bug from the report alone.",
   "criteria": {
    "true": "the report names a reproducible trigger, a file or endpoint, and the failure",
    "false": "the report is vague, needs product input, or has no reproducible failure"
   }
  },
  "component": {
   "type": "choice",
   "instructions": "Which component owns the fix for this bug report?",
   "criteria": {
    "pricing": "the defect is in coupon/discount calculation code and a pricing engineer should own the fix",
    "checkout": "the defect is in the HTTP checkout handler or its request validation",
    "frontend": "the defect is in the browser client and no server change is needed",
    "infra": "the defect is in deployment, config or capacity and no application code changes"
   }
  },
  "fixability": {
   "type": "score",
   "instructions": "How fixable is this bug from the report alone?",
   "criteria": [
    "needs product input",
    "needs investigation",
    "fixable from the report"
   ]
  }
 },
 "rules": [
  {
   "question": "fixable",
   "below": 0.3,
   "action": "fail"
  },
  {
   "question": "component",
   "is": "pricing",
   "action": "skip_to",
   "target": "fix-pricing"
  },
  {
   "question": "fixability",
   "at_least": 1.5,
   "action": "skip_to",
   "target": "draft-pr"
  }
 ],
