;; The Clojure (JVM) project.
;;
;;   clojure -M -m toolnexus.demo
;;
;; `src` is a symlink to ../src — the ONE copy of the source, shared with
;; cljgo-app. koine comes from Clojars, and is the only dependency: no HTTP
;; client, no JSON library, no process library. That is the point.
{:paths ["src"]
 :deps  {org.clojure/clojure           {:mvn/version "1.12.5"}
         net.clojars.muthuishere/koine {:mvn/version "0.6.0"}}}
