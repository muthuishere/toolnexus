;; The Clojure port. koine from Clojars; nothing else third-party.
;;
;;   clojure -M -m toolnexus.test-main     run the suite (count-gated)
;;   clojure -T:build jar                  build the release jar + pom
{:paths ["src"]
 :deps  {org.clojure/clojure           {:mvn/version "1.12.5"}
         net.clojars.muthuishere/koine {:mvn/version "0.11.0"}}
 :aliases
 ;; Release tooling ONLY, and only reachable through this alias — it must never
 ;; move up into :deps. `./deps-purity-check.sh` resolves the DEFAULT transitive
 ;; classpath and fails on anything beyond clojure + spec.alpha +
 ;; core.specs.alpha + koine, and tools.build carries plenty. That gate is what
 ;; keeps the cljgo half of the port loadable, so the alias is not tidiness.
 {:build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.9"}
                       slipset/deps-deploy           {:mvn/version "0.2.2"}}
          :ns-default build}}}
