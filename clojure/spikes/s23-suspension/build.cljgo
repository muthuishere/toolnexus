;; S23 — cljgo side. THE SAME src/toolnexus/suspension.cljc, the same koine
;; artifact from Clojars. No vendored copy, no reader conditional.
;;
;;   cljgo build        compile to a native binary
;;   cljgo build run    ...and run it
(defn build [b]
  (dep b "net.clojars.muthuishere/koine" {:mvn/version "0.8.2"})
  (let [app (exe b {:name "suspension" :main "src/toolnexus/suspension.cljc"})]
    (install b app)
    (run b app)))
