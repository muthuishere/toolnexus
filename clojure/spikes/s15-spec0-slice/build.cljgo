;; S12 — cljgo side. THE SAME src/toolnexus/slice.cljc, the same koine artifact
;; from Clojars. No vendored copy, no git coordinate, no reader conditional in
;; toolnexus' own source.
;;
;;   cljgo build        compile to a native binary
;;   cljgo build run    ...and run it
(defn build [b]
  (dep b "net.clojars.muthuishere/koine" {:mvn/version "0.6.0"})
  (let [app (exe b {:name "slice" :main "src/toolnexus/slice.cljc"})]
    (install b app)
    (run b app)))
