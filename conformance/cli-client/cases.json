  "parse": [
    {
      "in": "{\"content\":\"hi\"}",
      "content": "hi"
    },
    {
      "in": "```json\n{\"content\":\"fenced\"}\n```\n\n",
      "content": "fenced"
    },
    {
      "in": "Sure! {\"content\":\"wrapped\"} done",
      "content": "wrapped"
    },
    {
      "in": "{\"choices\":[{\"message\":{\"content\":\"openai\"}}]}",
      "content": "openai"
    },
    {
      "in": "{\"message\":{\"content\":\"msg\"}}",
      "content": "msg"
    },
    {
      "in": "{\"tool_calls\":[{\"id\":\"a\",\"function\":{\"name\":\"t\",\"arguments\":\"{\\\"x\\\":1}\"}}]}",
      "toolCall": {
        "name": "t",
        "id": "a",
        "arguments": {
          "x": 1
        }
      }
    },
    {
      "in": "{\"tool_calls\":[{\"name\":\"flat\",\"arguments\":{\"x\":1}}]}",
      "toolCall": {
        "name": "flat",
        "arguments": {
          "x": 1
        }
      }
    },
    {
      "in": "plain text answer",
      "content": "plain text answer"
    },
    {
      "in": "{\"content\":\"x\"} trailing {",
      "content": "x"
    },
    {
      "in": "{\"answer\":1}",
      "content": "{\"answer\":1}"
    },
    {
      "in": "{\"content\":\"x\"} {\"content\":\"y\"}",
      "content": "{\"content\":\"x\"} {\"content\":\"y\"}"
    },
    {
      "in": "{\"content\":null}",
      "content": ""
    },
    {
      "in": "{\"tool_calls\":[],\"content\":\"empty calls\"}",
      "content": "empty calls"
    }
  ],
