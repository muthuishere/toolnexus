  "schemaCases": [
    {
      "name": "tools_follow_the_first_supporting_client",
      "clients": [
        {
          "name": "a",
          "verbs": {
            "image": {
              "args": [
                {
                  "name": "prompt",
                  "required": true
                },
                {
                  "name": "width",
                  "required": false
                }
              ]
            }
          }
        },
        {
          "name": "b",
          "verbs": {
            "image": {
              "args": [
                {
                  "name": "seed",
                  "required": false
                },
                {
                  "name": "prompt",
                  "required": true
                }
              ]
            },
            "speech": {
              "args": [
                {
                  "name": "voice",
                  "required": false
                },
                {
                  "name": "text",
                  "required": true
                }
              ]
            }
          }
        },
        {
          "name": "c",
          "verbs": {
            "talk": {
              "args": [
                {
                  "name": "image",
                  "required": true
                },
                {
                  "name": "audio",
                  "required": true
                }
              ]
            },
            "transcribe": {}
          }
        }
      ],
      "tools": [
        {
          "name": "generate_image",
          "description": "Generate an image from a text prompt.",
          "source": "media",
          "inputSchema": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string",
                "description": "What to draw."
              },
              "width": {
                "type": "integer",
                "description": "Width in pixels."
              }
            },
            "required": [
              "prompt"
            ]
          }
        },
        {
          "name": "generate_speech",
          "description": "Speak text aloud and return the audio.",
          "source": "media",
          "inputSchema": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "description": "The text to speak."
              },
              "voice": {
                "type": "string",
                "description": "Voice name or id, including a cloned voice."
              }
            },
            "required": [
              "text"
            ]
          }
        },
        {
          "name": "transcribe_audio",
          "description": "Transcribe speech in an audio file to text.",
          "source": "media",
          "inputSchema": {
            "type": "object",
            "properties": {
              "audio": {
                "type": "string",
                "description": "URL or local path of the audio."
              },
              "language": {
                "type": "string",
                "description": "Language of the speech as an ISO 639-1 code, e.g. en."
              }
            },
            "required": [
              "audio"
            ]
          }
        },
        {
          "name": "talking_video",
          "description": "Make the person in an image speak, from speech audio or from text (lip-synced video).",
          "source": "media",
          "inputSchema": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "description": "URL or local path of the face image."
              },
              "audio": {
                "type": "string",
                "description": "URL or local path of the speech audio."
              }
            },
            "required": [
              "image",
              "audio"
            ]
          }
        }
      ]
    }
  ],
  "emptyClients": {
    "error": "media: no clients"
  }
}
