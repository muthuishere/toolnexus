{
  "_doc": "MCP handler conformance (SPEC §7C.1, ADR 0039). See README.md for the harness contract. Every port builds the handler from `fixture` + the scenario's `config`, replays each scenario's steps in order over real HTTP (or the port's native in-process request), and asserts status, headers and the parsed JSON body (deep equality, key order ignored). Change a byte here => change it in all eight ports in the same PR.",
  "fixture": {
    "auth": {
      "tokens": { "Bearer alice": "alice", "Bearer admin": "admin" },
      "wwwAuthenticate": "Bearer resource_metadata=\"https://mcp.example.test/.well-known/oauth-protected-resource\""
    },
    "tools": [
      { "name": "echo", "description": "Echo text back",
        "inputSchema": { "type": "object", "properties": { "text": { "type": "string" } } },
        "annotations": { "title": "Echo", "readOnlyHint": true },
        "behavior": "echo" },
      { "name": "whoami", "description": "Identity and request _meta.trace",
        "inputSchema": { "type": "object" },
        "behavior": "whoami" },
      { "name": "wipe", "description": "Admin only",
        "inputSchema": { "type": "object" },
        "hints": { "readOnly": false, "destructive": true, "openWorld": false },
        "visibleTo": ["admin"],
        "behavior": "static", "result": { "output": "wiped" } },
      { "name": "denied", "description": "Always denied",
        "inputSchema": { "type": "object" },
        "decision": { "kind": "deny", "message": "not for you" },
        "behavior": "static", "result": { "output": "MUST NOT RUN" } },
      { "name": "denied_default", "description": "Denied with no message",
        "inputSchema": { "type": "object" },
        "decision": { "kind": "deny" },
        "behavior": "static", "result": { "output": "MUST NOT RUN" } },
      { "name": "confirm_plain", "description": "Confirm without fallback",
        "inputSchema": { "type": "object" },
        "decision": { "kind": "confirm", "message": "Delete it?" },
        "behavior": "static", "result": { "output": "MUST NOT RUN" } },
      { "name": "confirm_fallback", "description": "Confirm with a shaped fallback",
        "inputSchema": { "type": "object" },
        "decision": { "kind": "confirm", "message": "Delete it?",
                      "result": { "output": "re-call with nonce n-1", "isError": false, "structured": { "nonce": "n-1" } } },
        "behavior": "static", "result": { "output": "MUST NOT RUN" } },
      { "name": "stats", "description": "Structured result",
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object", "properties": { "count": { "type": "integer" } } },
        "behavior": "static", "result": { "output": "", "structured": { "count": 3 }, "meta": { "usage": { "units": 2 } } } },
      { "name": "boom", "description": "Execute fails",
        "inputSchema": { "type": "object" },
        "behavior": "error", "error": "kaboom" }
    ]
  },
  "scenarios": [
    {
      "name": "auth_401_with_www_authenticate",
      "config": { "auth": true },
      "steps": [
        { "request": { "method": "POST", "token": "Bearer mallory",
                       "body": { "jsonrpc": "2.0", "id": 1, "method": "initialize", "params": { "protocolVersion": "2025-06-18" } } },
          "expect": { "status": 401, "headers": { "WWW-Authenticate": "Bearer resource_metadata=\"https://mcp.example.test/.well-known/oauth-protected-resource\"" } } },
        { "request": { "method": "POST",
                       "body": { "jsonrpc": "2.0", "id": 1, "method": "initialize", "params": { "protocolVersion": "2025-06-18" } } },
          "expect": { "status": 401 } }
      ]
    },
    {
      "name": "stateful_session_lifecycle",
      "config": { "auth": true, "name": "fixture", "title": "Fixture Server", "version": "1.2.3", "instructions": "Use the tools." },
      "token": "Bearer alice",
      "steps": [
        { "request": { "method": "POST",
                       "body": { "jsonrpc": "2.0", "id": 1, "method": "initialize",
                                 "params": { "protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": { "name": "conf", "version": "1" } } } },
          "capture": "sid",
          "expect": { "status": 200, "headersPresent": ["Mcp-Session-Id"],
                      "json": { "jsonrpc": "2.0", "id": 1, "result": {
                        "protocolVersion": "2025-06-18",
                        "capabilities": { "tools": { "listChanged": true } },
                        "serverInfo": { "name": "fixture", "title": "Fixture Server", "version": "1.2.3" },
                        "instructions": "Use the tools." } } } },
        { "request": { "method": "POST", "session": true, "version": "2025-06-18",
                       "body": { "jsonrpc": "2.0", "method": "notifications/initialized" } },
          "expect": { "status": 202 } },
        { "request": { "method": "POST", "version": "2025-06-18",
                       "body": { "jsonrpc": "2.0", "id": 2, "method": "ping" } },
          "expect": { "status": 400 } },
        { "request": { "method": "POST", "sessionId": "not-a-session", "version": "2025-06-18",
                       "body": { "jsonrpc": "2.0", "id": 2, "method": "ping" } },
          "expect": { "status": 404 } },
        { "request": { "method": "POST", "session": true, "version": "2099-01-01",
                       "body": { "jsonrpc": "2.0", "id": 2, "method": "ping" } },
          "expect": { "status": 400 } },
        { "request": { "method": "POST", "session": true, "version": "2025-06-18",
                       "body": { "jsonrpc": "2.0", "id": 3, "method": "ping" } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 3, "result": {} } } },
        { "request": { "method": "POST", "session": true, "version": "2025-06-18",
                       "rawBody": "[{\"jsonrpc\":\"2.0\",\"id\":4,\"method\":\"ping\"}]" },
          "expect": { "status": 400, "json": { "jsonrpc": "2.0", "id": null, "error": { "code": -32600, "message": "batch requests are not supported" } } } },
        { "request": { "method": "POST", "session": true, "version": "2025-06-18", "contentType": "text/plain",
                       "body": { "jsonrpc": "2.0", "id": 5, "method": "ping" } },
          "expect": { "status": 415 } },
        { "request": { "method": "POST", "session": true, "version": "2025-06-18",
                       "body": { "jsonrpc": "2.0", "id": 6, "method": "resources/list" } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 6, "error": { "code": -32601, "message": "method not found: resources/list" } } } },
        { "request": { "method": "GET", "session": true, "accept": "application/json" },
          "expect": { "status": 405 } },
        { "request": { "method": "PUT", "session": true },
          "expect": { "status": 405 } },
        { "request": { "method": "DELETE", "session": true },
          "expect": { "status": 200 } },
        { "request": { "method": "POST", "session": true, "version": "2025-06-18",
                       "body": { "jsonrpc": "2.0", "id": 7, "method": "ping" } },
          "expect": { "status": 404 } }
      ]
    },
    {
      "name": "per_identity_tools_list_and_call",
      "config": { "auth": true, "stateless": true },
      "steps": [
        { "request": { "method": "POST", "token": "Bearer alice",
                       "body": { "jsonrpc": "2.0", "id": 1, "method": "tools/list" } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 1, "result": { "tools": [
            { "name": "echo", "description": "Echo text back",
              "inputSchema": { "type": "object", "properties": { "text": { "type": "string" } } },
              "annotations": { "title": "Echo", "readOnlyHint": true } },
            { "name": "whoami", "description": "Identity and request _meta.trace", "inputSchema": { "type": "object" } },
            { "name": "denied", "description": "Always denied", "inputSchema": { "type": "object" } },
            { "name": "denied_default", "description": "Denied with no message", "inputSchema": { "type": "object" } },
            { "name": "confirm_plain", "description": "Confirm without fallback", "inputSchema": { "type": "object" } },
            { "name": "confirm_fallback", "description": "Confirm with a shaped fallback", "inputSchema": { "type": "object" } },
            { "name": "stats", "description": "Structured result", "inputSchema": { "type": "object" },
              "outputSchema": { "type": "object", "properties": { "count": { "type": "integer" } } } },
            { "name": "boom", "description": "Execute fails", "inputSchema": { "type": "object" } }
          ] } } } },
        { "request": { "method": "POST", "token": "Bearer admin",
                       "body": { "jsonrpc": "2.0", "id": 2, "method": "tools/list" } },
          "expect": { "status": 200, "jsonPath": { "result.tools.2": {
            "name": "wipe", "description": "Admin only", "inputSchema": { "type": "object" },
            "annotations": { "readOnlyHint": false, "destructiveHint": true, "openWorldHint": false } } } } },
        { "request": { "method": "POST", "token": "Bearer alice",
                       "body": { "jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": { "name": "wipe", "arguments": {} } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 3, "error": { "code": -32602, "message": "tool not found: wipe" } } } },
        { "request": { "method": "POST", "token": "Bearer admin",
                       "body": { "jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": { "name": "wipe", "arguments": {} } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 4, "result": { "content": [ { "type": "text", "text": "wiped" } ] } } } },
        { "request": { "method": "POST", "token": "Bearer alice",
                       "body": { "jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": { "name": "echo", "arguments": { "text": "hi" } } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 5, "result": { "content": [ { "type": "text", "text": "hi" } ] } } } },
        { "request": { "method": "POST", "token": "Bearer alice",
                       "body": { "jsonrpc": "2.0", "id": 6, "method": "tools/call", "params": { "name": "whoami", "_meta": { "trace": "t-1" } } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 6, "result": { "content": [ { "type": "text", "text": "alice|t-1" } ] } } } },
        { "request": { "method": "POST", "token": "Bearer alice",
                       "body": { "jsonrpc": "2.0", "id": 7, "method": "tools/call", "params": { "name": "boom" } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 7, "result": { "content": [ { "type": "text", "text": "kaboom" } ], "isError": true } } } }
      ],
      "expectExecuted": ["wipe", "echo", "whoami", "boom"]
    },
    {
      "name": "gate_deny_and_confirm_without_elicitation",
      "config": { "stateless": true },
      "steps": [
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": { "name": "denied" } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 1, "result": { "content": [ { "type": "text", "text": "not for you" } ], "isError": true } } } },
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": { "name": "denied_default" } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 2, "result": { "content": [ { "type": "text", "text": "denied" } ], "isError": true } } } },
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 3, "method": "tools/call", "params": { "name": "confirm_plain" } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 3, "result": { "content": [ { "type": "text", "text": "confirmation required: Delete it?" } ], "isError": true } } } },
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": { "name": "confirm_fallback" } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 4, "result": { "content": [ { "type": "text", "text": "re-call with nonce n-1" } ], "structuredContent": { "nonce": "n-1" } } } } }
      ],
      "expectExecuted": [],
      "expectOnCall": [
        { "name": "denied", "isError": true, "decision": "deny" },
        { "name": "denied_default", "isError": true, "decision": "deny" },
        { "name": "confirm_plain", "isError": true, "decision": "confirm" },
        { "name": "confirm_fallback", "isError": false, "decision": "confirm" }
      ]
    },
    {
      "name": "structured_and_meta",
      "config": { "stateless": true },
      "steps": [
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 1, "method": "tools/call", "params": { "name": "stats" } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 1, "result": {
            "content": [ { "type": "text", "text": "{\"count\":3}" } ],
            "structuredContent": { "count": 3 },
            "_meta": { "usage": { "units": 2 } } } } } }
      ]
    },
    {
      "name": "default_protocol_versions",
      "config": { "stateless": true },
      "steps": [
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 1, "method": "initialize", "params": { "protocolVersion": "2025-11-25" } } },
          "expect": { "status": 200, "headersAbsent": ["Mcp-Session-Id"],
                      "json": { "jsonrpc": "2.0", "id": 1, "result": {
                        "protocolVersion": "2025-06-18",
                        "capabilities": { "tools": { "listChanged": true } },
                        "serverInfo": { "name": "toolnexus", "version": "0.1.0" } } } } },
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 2, "method": "initialize", "params": { "protocolVersion": "2025-03-26" } } },
          "expect": { "status": 200, "jsonPath": { "result.protocolVersion": "2025-06-18" } } },
        { "request": { "method": "POST", "version": "2025-11-25", "body": { "jsonrpc": "2.0", "id": 3, "method": "ping" } },
          "expect": { "status": 400 } },
        { "request": { "method": "POST", "version": "2025-06-18",
                       "body": { "jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": { "name": "echo", "arguments": [1] } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 4, "error": { "code": -32602, "message": "arguments must be an object" } } } }
      ]
    },
    {
      "name": "opt_in_2025_11_25",
      "config": { "stateless": true, "statelessSessionId": "stateless", "protocolVersions": ["2026-07-28", "2025-11-25", "2025-06-18", "2025-03-26"] },
      "steps": [
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 1, "method": "initialize", "params": { "protocolVersion": "2025-11-25" } } },
          "expect": { "status": 200, "headers": { "Mcp-Session-Id": "stateless" }, "jsonPath": { "result.protocolVersion": "2025-11-25" } } },
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 2, "method": "initialize", "params": { "protocolVersion": "2026-07-28" } } },
          "expect": { "status": 200, "jsonPath": { "result.protocolVersion": "2025-11-25" } } },
        { "request": { "method": "POST", "body": { "jsonrpc": "2.0", "id": 3, "method": "initialize", "params": { "protocolVersion": "2025-06-18" } } },
          "expect": { "status": 200, "jsonPath": { "result.protocolVersion": "2025-06-18" } } },
        { "request": { "method": "POST", "version": "2025-03-26", "body": { "jsonrpc": "2.0", "id": 4, "method": "ping" } },
          "expect": { "status": 400 } },
        { "request": { "method": "POST", "version": "2026-07-28", "body": { "jsonrpc": "2.0", "id": 5, "method": "ping" } },
          "expect": { "status": 400 } },
        { "request": { "method": "POST", "sessionId": "anything", "version": "2025-11-25", "body": { "jsonrpc": "2.0", "id": 6, "method": "ping" } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 6, "result": {} } } },
        { "request": { "method": "POST", "version": "2025-11-25",
                       "body": { "jsonrpc": "2.0", "id": 7, "method": "tools/call", "params": { "name": "echo", "arguments": [1] } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 7, "result": { "content": [ { "type": "text", "text": "invalid arguments: must be an object" } ], "isError": true } } } },
        { "request": { "method": "POST", "version": "2025-06-18",
                       "body": { "jsonrpc": "2.0", "id": 8, "method": "tools/call", "params": { "name": "echo", "arguments": [1] } } },
          "expect": { "status": 200, "json": { "jsonrpc": "2.0", "id": 8, "error": { "code": -32602, "message": "arguments must be an object" } } } }
      ],
      "expectExecuted": []
    }
  ]
}
