{
  "name": "toolnexus",
  "scan": {
    "markers": ["mix.exs", "deps.edn", "Toolnexus.slnx"],
    "include": ["csharp", "benchmarks/run_*"],
    "exclude": ["clojure/toolnexus-test", "clojure/spikes"]
  },
  "modules": [
