<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Toolnexus/Toolnexus.csproj" />
    <!-- Test-only helper (AcpClientTests): a scripted ACP server spawned as a real child
         process over real OS pipes. Referencing it (rather than just adding it to the .slnx)
         guarantees it is built before the tests that spawn it, and copies FakeAcpServer.dll +
         its runtime files next to Toolnexus.Tests.dll so AcpClientTests can find it by a
         same-directory path instead of searching the tree. -->
    <ProjectReference Include="../FakeAcpServer/FakeAcpServer.csproj" />
    <!-- Test-only MCP 2026-07-28 fixture server + dev authorization server (in-process over HTTP, child
         process over stdio). Ported from spikes/mcp-2026/csharp; never part of the Toolnexus package. -->
    <ProjectReference Include="../Mcp2026Fixture/Mcp2026Fixture.csproj" />
  </ItemGroup>

</Project>