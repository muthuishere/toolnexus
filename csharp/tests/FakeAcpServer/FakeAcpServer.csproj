<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!--
      Test-only helper: a minimal, scripted ACP (Agent Client Protocol) server used exclusively
      by AcpClientTests (Toolnexus.Tests) to exercise Toolnexus.Acp.AcpClient over real OS pipes,
      with no network and no real ACP agent (devin/gemini/zed). Ported from the Go reference
      spike at spikes/acp/fakeagent/main.go — see AcpClientTests.cs for how it is spawned.
      Not published, not part of the Toolnexus package.
    -->
  </PropertyGroup>

</Project>
